    "excludeContent": [
      {
        "id": "excl-cgpa",
        "label": "CGPA",
        "pattern": "\\bcgpa\\b",
        "match": "regex",
        "reason": "Academic statistics do not belong on the profile."
      },
      {
        "id": "excl-school-marks",
        "label": "School marks",
        "pattern": "(school|class|10th|12th|matriculation)\\s*(marks|percentage|score|percent)",
        "match": "regex",
        "reason": "Academic statistics do not belong on the profile."
      },
      {
        "id": "excl-marksheets",
        "label": "Mark sheets",
        "pattern": "\\b(report\\s*card|mark\\s*sheets?|transcript)\\b",
        "match": "regex",
        "reason": "Résumé-style academic clutter."
